// tsconfig.json
// Settings for the code check (tools/check.mjs). Only the src/ folder is checked.
{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "es2020",
    "module": "es2020",
    "moduleResolution": "node",
    "lib": ["es2020", "dom"],
    "strict": false,
    "noUnusedLocals": true,
    "skipLibCheck": true
  },
  "include": ["src"]
}
